# Шаблон окружения для модуля yandex_delivery.
# Скопируй этот файл в .env (он в .gitignore и в git не попадёт) и впиши боевой токен.
# Для тестового окружения ничего заполнять НЕ нужно — используется публичный тест-токен.

# Окружение: test | prod  (по умолчанию test)
YANDEX_DELIVERY_ENV=test

# Боевой OAuth-токен из личного кабинета Яндекс Доставки (нужен только для prod).
# YANDEX_DELIVERY_TOKEN=y0__xxxxxxxxxxxxxxxxxxxxxxxx
